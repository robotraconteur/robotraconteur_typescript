{
    "name": "robotraconteur",
    "version": "0.1.0",
    "description": "Small pure TypeScript Robot Raconteur client for browsers",
    "license": "Apache-2.0",
    "author": "Wason Technology, LLC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/robotraconteur/robotraconteur_typescript.git"
    },
    "homepage": "https://robotraconteur.github.io/robotraconteur_typescript/",
    "bugs": "https://github.com/robotraconteur/robotraconteur_typescript/issues",
    "keywords": [
        "robotraconteur",
        "robot raconteur",
        "robotics",
        "automation",
        "websocket"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./internal": {
            "types": "./dist/internal.d.ts",
            "default": "./dist/internal.js"
        },
        "./validators": {
            "types": "./dist/ServiceDefinitionValidators.d.ts",
            "default": "./dist/ServiceDefinitionValidators.js"
        },
        "./service-definition.schema.json": "./service-definition.schema.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "service-definition.schema.json",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "jsdelivr": "./dist/robotraconteur.min.js",
    "unpkg": "./dist/robotraconteur.min.js",
    "scripts": {
        "build": "tsc -p tsconfig.json && node scripts/bundle-browser.mjs",
        "prepack": "npm run build",
        "build:test": "tsc -p tsconfig.test.json && node scripts/bundle-browser-test.mjs",
        "test:unit": "npm run build:test && node --test \"dist-test/test/unit/*.test.js\"",
        "test:integration": "npm run build:test && node --test --test-concurrency=1 \"dist-test/test/integration/*.test.js\"",
        "test": "npm run build:test && node --test --test-concurrency=1 \"dist-test/test/unit/*.test.js\" \"dist-test/test/integration/*.test.js\"",
        "size": "node scripts/size-report.mjs",
        "fixtures": "python3 scripts/generate_robdef_oracle.py && python3 scripts/record_vectors.py && python3 scripts/port_core_client_tests.py",
        "docs": "tsc -p tsconfig.json && typedoc"
    },
    "devDependencies": {
        "@types/node": "22.10.2",
        "esbuild": "0.24.2",
        "playwright": "1.49.1",
        "typedoc": "0.28.20",
        "typescript": "5.7.2"
    }
}
